# Local simulation and build outputs
.sim/
bin/
*.test
*.out

# Operator-local configuration. Real values live here; never commit them.
/.env
/deploy/.env
/deploy/snp-digests.env
*.pem.pub

# SEV-SNP image build artifacts: regenerable and machine-specific.
# The build recipe itself (Dockerfile, loader, tier-build.sh, pins.env) is tracked.
deploy/snp-image/*.raw
deploy/snp-image/*.efi
deploy/snp-image/*.zst
deploy/snp-image/*.blob
deploy/snp-image/app-bundle.tar
deploy/secure-boot/*.key
# The variable store §2 rebuilds aws-uefi-data.b64 from: machine-specific,
# regenerable, and not something the seal commit should pick up.
deploy/secure-boot/vars.fd

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Release catalog writer locks; public history itself is tracked.
/releases/.*.lock
__pycache__/
