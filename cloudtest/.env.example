# Copy to .env and fill in. cloudtest refuses to run against real AWS without
# credentials, and every value here is optional (safe defaults exist in
# config.py / lib.sh) EXCEPT TOKENHIVE_USER, which is required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# REQUIRED and UNIQUE per operator: the owner tag stamped on every launched
# resource. Deletion matches it exactly, so two operators must use distinct
# values or they will delete each other's machines. Never leave it at a shared
# default.
TOKENHIVE_USER=your-name-here
# Pinned to us-west-2 unless you explicitly override.
# TOKENHIVE_REGION=us-west-2
# AMD SEV-SNP only: m6a / c6a / r6a.
# TOKENHIVE_INSTANCE_TYPE=m6a.large
