# Operator configuration for the SEV-SNP image build (deploy/snp-build.sh).
#
# Copy this file to deploy/.env and fill in the values. deploy/.env is
# gitignored. Every build pin lives in deploy/snp-image/pins.env instead, so
# nothing here can change the measured identity silently.
#
# The build also needs deploy/secure-boot/R.key, the Secure Boot signing key.
# It is gitignored on purpose and must be provisioned out of band.

# Required even for AWS builds: snp-build.sh reads it at startup.
GCP_PROJECT=your-gcp-project-id

# Region the AMI is registered in.
AWS_SNP_REGION=eu-west-1

# Optional: staging bucket for the disk image. Defaults to snp-vmimport-<account>.
# SNP_S3_BUCKET=snp-vmimport-123456789012

# Optional: HTTP proxy used by the Docker and AWS steps.
# SNP_PROXY=http://127.0.0.1:7890
