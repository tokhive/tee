{
  "version": 1,
  "hosts": [
    "127.0.0.1:18080",
    "api.openai.com",
    "api.anthropic.com",
    "chatgpt.com",
    "api.wokey.ai",
    "cloudcode-pa.googleapis.com",
    "daily-cloudcode-pa.googleapis.com",
    "generativelanguage.googleapis.com",
    "api.x.ai",
    "cli-chat-proxy.grok.com",
    "api.meta.ai",
    "open.bigmodel.cn",
    "api.z.ai",
    "api.moonshot.cn",
    "api.moonshot.ai",
    "api.kimi.com",
    "api.kimi.ai",
    "api.deepseek.com",
    "api.minimaxi.com",
    "api.minimax.io"
  ],
  "rules": [
    {
      "methods": ["POST"],
      "path": "/v1/chat/completions",
      "allow_stream": true,
      "query_keys": ["fault"]
    },
    {
      "methods": ["POST"],
      "path": "/v1/responses",
      "allow_stream": true,
      "query_keys": ["fault"]
    },
    {
      "methods": ["GET"],
      "path": "/v1/models"
    },
    {
      "methods": ["POST"],
      "path": "/v1/messages",
      "allow_stream": true,
      "query_keys": ["fault", "beta"]
    },
    {
      "methods": ["POST"],
      "path": "/backend-api/codex/responses",
      "allow_stream": true
    },
    {
      "methods": ["GET"],
      "path": "/backend-api/codex/models",
      "query_keys": ["client_version"]
    },
    {
      "methods": ["POST"],
      "path": "/v1internal:generateContent"
    },
    {
      "methods": ["POST"],
      "path": "/v1internal:streamGenerateContent",
      "allow_stream": true,
      "query_keys": ["alt"]
    },
    {
      "methods": ["POST"],
      "path": "/v1internal:countTokens"
    },
    {
      "methods": ["POST"],
      "path": "/v1beta/models/{model}",
      "allow_stream": true,
      "query_keys": ["alt"]
    },
    {
      "methods": ["POST"],
      "path": "/chat/completions",
      "allow_stream": true
    },
    {
      "methods": ["POST"],
      "path": "/responses",
      "allow_stream": true
    },
    {
      "methods": ["POST"],
      "path": "/anthropic/v1/messages",
      "allow_stream": true,
      "query_keys": ["beta"]
    },
    {
      "methods": ["POST"],
      "path": "/api/anthropic/v1/messages",
      "allow_stream": true,
      "query_keys": ["beta"]
    },
    {
      "methods": ["POST"],
      "path": "/api/paas/v4/chat/completions",
      "allow_stream": true
    },
    {
      "methods": ["POST"],
      "path": "/api/paas/v4/responses",
      "allow_stream": true
    },
    {
      "methods": ["POST"],
      "path": "/api/coding/paas/v4/chat/completions",
      "allow_stream": true
    },
    {
      "methods": ["POST"],
      "path": "/coding/v1/chat/completions",
      "allow_stream": true
    },
    {
      "methods": ["POST"],
      "path": "/coding/v1/responses",
      "allow_stream": true
    },
    {
      "methods": ["POST"],
      "path": "/coding/v1/messages",
      "allow_stream": true,
      "query_keys": ["beta"]
    },
    {
      "methods": ["GET"],
      "path": "/v1/realtime",
      "allow_stream": true,
      "allow_any_query": true
    }
  ],
  "limits": {
    "max_response_bytes": 33554432,
    "max_body_bytes": 33554432,
    "allowed_headers": [
      "content-type",
      "content-encoding",
      "accept",
      "user-agent",
      "x-client-request-id",
      "openai-organization",
      "openai-project",
      "chatgpt-account-id",
      "originator",
      "version",
      "session-id",
      "thread-id",
      "x-openai-internal-codex-responses-lite",
      "x-codex-beta-features",
      "x-codex-turn-state",
      "x-codex-turn-metadata",
      "x-codex-window-id",
      "x-codex-parent-thread-id",
      "x-openai-subagent",
      "x-codex-routing-hint",
      "anthropic-version",
      "anthropic-beta",
      "anthropic-dangerous-direct-browser-access",
      "x-app",
      "x-stainless-lang",
      "x-stainless-package-version",
      "x-stainless-os",
      "x-stainless-arch",
      "x-stainless-runtime",
      "x-stainless-runtime-version",
      "x-stainless-retry-count",
      "x-stainless-timeout",
      "x-stainless-helper-method",
      "x-claude-code-session-id",
      "x-claude-code-agent-id",
      "x-claude-code-parent-agent-id",
      "x-claude-remote-container-id",
      "x-claude-remote-session-id",
      "x-client-app",
      "x-anthropic-additional-protection",
      "origin",
      "sec-websocket-protocol",
      "x-xai-token-auth",
      "x-grok-client-version",
      "x-grok-client-identifier",
      "x-authenticateresponse",
      "x-grok-conv-id",
      "x-msh-platform",
      "x-msh-version",
      "x-msh-device-name",
      "x-msh-device-model",
      "x-msh-device-id",
      "x-client-id",
      "x-meta-ai-gateway-session-id",
      "x-tbh-session-id",
      "x-tbh-thread-id",
      "x-tbh-root-session-id",
      "x-tbh-agent-role",
      "x-tbh-contributor-mode",
      "cache-control"
    ]
  }
}
