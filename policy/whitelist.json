{
  "version": 1,
  "hosts": [
    "127.0.0.1:18080",
    "api.openai.com",
    "api.anthropic.com",
    "chatgpt.com"
  ],
  "rules": [
    {
      "methods": ["POST"],
      "path": "/v1/chat/completions",
      "allow_stream": true,
      "query_keys": ["fault"]
    },
    {
      "methods": ["POST"],
      "path": "/v1/responses",
      "allow_stream": true,
      "query_keys": ["fault"]
    },
    {
      "methods": ["POST"],
      "path": "/v1/messages",
      "allow_stream": true,
      "query_keys": ["fault", "beta"]
    },
    {
      "methods": ["POST"],
      "path": "/backend-api/codex/responses",
      "allow_stream": true
    },
    {
      "methods": ["GET"],
      "path": "/v1/realtime",
      "allow_stream": true,
      "allow_any_query": true
    }
  ],
  "limits": {
    "max_response_bytes": 8388608,
    "max_body_bytes": 8388608,
    "allowed_headers": [
      "content-type",
      "accept",
      "user-agent",
      "x-client-request-id",
      "chatgpt-account-id",
      "originator",
      "version",
      "session-id",
      "thread-id",
      "anthropic-version",
      "anthropic-beta",
      "anthropic-dangerous-direct-browser-access",
      "x-app",
      "x-stainless-lang",
      "x-stainless-package-version",
      "x-stainless-os",
      "x-stainless-arch",
      "x-stainless-runtime",
      "x-stainless-runtime-version",
      "x-stainless-retry-count",
      "x-stainless-timeout",
      "x-stainless-helper-method",
      "x-claude-code-session-id",
      "x-claude-code-agent-id",
      "x-claude-code-parent-agent-id",
      "x-claude-remote-container-id",
      "x-claude-remote-session-id",
      "x-client-app",
      "x-anthropic-additional-protection"
    ]
  }
}
